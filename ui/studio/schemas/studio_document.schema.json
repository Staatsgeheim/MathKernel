{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mathkernel:studio:editor-document:1",
  "title": "Proposed MathKernel Studio editor document",
  "description": "UI authoring and presentation only. Not an executable MathKernel workflow. Operation semantics require authoritative host validation.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "mk.studio/1"
    },
    "identity": {
      "type": "object",
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "not": {
            "enum": [
              "__proto__",
              "constructor",
              "prototype"
            ]
          }
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      },
      "required": [
        "document_id",
        "title"
      ],
      "additionalProperties": false
    },
    "authoring": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                "not": {
                  "enum": [
                    "__proto__",
                    "constructor",
                    "prototype"
                  ]
                }
              },
              "kind": {
                "enum": [
                  "operation",
                  "object_binding",
                  "subworkflow",
                  "unresolved"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "operation_ref": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                    "not": {
                      "enum": [
                        "__proto__",
                        "constructor",
                        "prototype"
                      ]
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "operation_version": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 128
              },
              "schema_digest": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              },
              "parameter_drafts": {
                "type": "object",
                "maxProperties": 256,
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                  "not": {
                    "enum": [
                      "__proto__",
                      "constructor",
                      "prototype"
                    ]
                  }
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "encoding": {
                      "enum": [
                        "text",
                        "json_text"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 1048576
                    }
                  },
                  "required": [
                    "encoding",
                    "text"
                  ],
                  "additionalProperties": false
                }
              },
              "input_bindings": {
                "type": "object",
                "maxProperties": 256,
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                  "not": {
                    "enum": [
                      "__proto__",
                      "constructor",
                      "prototype"
                    ]
                  }
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "host_instance_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                      "not": {
                        "enum": [
                          "__proto__",
                          "constructor",
                          "prototype"
                        ]
                      }
                    },
                    "workspace_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                      "not": {
                        "enum": [
                          "__proto__",
                          "constructor",
                          "prototype"
                        ]
                      }
                    },
                    "object_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                      "not": {
                        "enum": [
                          "__proto__",
                          "constructor",
                          "prototype"
                        ]
                      }
                    },
                    "resolution": {
                      "const": "unresolved"
                    }
                  },
                  "required": [
                    "host_instance_id",
                    "workspace_id",
                    "object_id",
                    "resolution"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "kind",
              "label",
              "operation_ref",
              "operation_version",
              "schema_digest",
              "parameter_drafts",
              "input_bindings"
            ],
            "additionalProperties": false
          },
          "maxItems": 5000
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                "not": {
                  "enum": [
                    "__proto__",
                    "constructor",
                    "prototype"
                  ]
                }
              },
              "source_node": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                "not": {
                  "enum": [
                    "__proto__",
                    "constructor",
                    "prototype"
                  ]
                }
              },
              "source_port": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                "not": {
                  "enum": [
                    "__proto__",
                    "constructor",
                    "prototype"
                  ]
                }
              },
              "target_node": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                "not": {
                  "enum": [
                    "__proto__",
                    "constructor",
                    "prototype"
                  ]
                }
              },
              "target_port": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                "not": {
                  "enum": [
                    "__proto__",
                    "constructor",
                    "prototype"
                  ]
                }
              }
            },
            "required": [
              "id",
              "source_node",
              "source_port",
              "target_node",
              "target_port"
            ],
            "additionalProperties": false
          },
          "maxItems": 10000
        },
        "desired_outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                "not": {
                  "enum": [
                    "__proto__",
                    "constructor",
                    "prototype"
                  ]
                }
              },
              "port_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                "not": {
                  "enum": [
                    "__proto__",
                    "constructor",
                    "prototype"
                  ]
                }
              }
            },
            "required": [
              "node_id",
              "port_id"
            ],
            "additionalProperties": false
          },
          "maxItems": 5000
        }
      },
      "required": [
        "revision",
        "nodes",
        "edges",
        "desired_outputs"
      ],
      "additionalProperties": false
    },
    "presentation": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "node_positions": {
          "type": "object",
          "maxProperties": 5000,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "not": {
              "enum": [
                "__proto__",
                "constructor",
                "prototype"
              ]
            }
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "y": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                "not": {
                  "enum": [
                    "__proto__",
                    "constructor",
                    "prototype"
                  ]
                }
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
                  "not": {
                    "enum": [
                      "__proto__",
                      "constructor",
                      "prototype"
                    ]
                  }
                },
                "maxItems": 5000
              }
            },
            "required": [
              "id",
              "title",
              "members"
            ],
            "additionalProperties": false
          },
          "maxItems": 5000
        },
        "viewport": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "zoom": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 8
            }
          },
          "required": [
            "x",
            "y",
            "zoom"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "revision",
        "node_positions",
        "groups",
        "viewport"
      ],
      "additionalProperties": false
    },
    "host_binding": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "host_instance_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "not": {
                "enum": [
                  "__proto__",
                  "constructor",
                  "prototype"
                ]
              }
            },
            "workspace_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "not": {
                "enum": [
                  "__proto__",
                  "constructor",
                  "prototype"
                ]
              }
            },
            "workflow_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "not": {
                "enum": [
                  "__proto__",
                  "constructor",
                  "prototype"
                ]
              }
            },
            "workflow_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "not": {
                "enum": [
                  "__proto__",
                  "constructor",
                  "prototype"
                ]
              }
            }
          },
          "required": [
            "host_instance_id",
            "workspace_id",
            "workflow_ref",
            "workflow_revision"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "identity",
    "authoring",
    "presentation",
    "host_binding"
  ],
  "additionalProperties": false
}
